{
  "compilerOptions": {
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noImplicitThis": true,
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "nodenext",
    "target": "esnext",
    "lib": ["ESNext"],
    "types": ["node"]
  }
}
