{
  "name": "build",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "optionalDependencies": {
    "sass-embedded-darwin-arm64": "1.104.1",
    "sass-embedded-darwin-x64": "1.104.1",
    "sass-embedded-linux-arm64": "1.104.1",
    "sass-embedded-linux-x64": "1.104.1",
    "sass-embedded-win32-arm64": "1.104.1",
    "sass-embedded-win32-x64": "1.104.1"
  },
  "dependencies": {
    "@types/micromatch": "4.0.10",
    "@types/node": "24.13.5",
    "browserslist": "^4.28.9",
    "esbuild": "0.28.2",
    "fast-glob": "3.3.3",
    "fast-xml-parser": "5.11.1",
    "json-stringify-pretty-compact": "4.0.0",
    "lightningcss": "^1.33.0",
    "micromatch": "4.0.8",
    "picocolors": "^1.1.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev": "node --no-warnings src/main.ts $@"
  },
  "browserslist": [
    "defaults",
    "not op_mini all",
    "not kaios <= 4",
    "firefox >= 115",
    "chrome >= 112",
    "edge >= 111",
    "opera >= 97",
    "safari >= 16.2",
    "iOS >= 16.2"
  ]
}
