  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "dependencies": {
    "@types/micromatch": "4.0.10",
    "@types/node": "24.19.0",
    "browserslist": "^4.29.3",
    "esbuild": "0.28.2",
    "fast-glob": "3.3.3",
    "json-stringify-pretty-compact": "4.0.0",
    "lightningcss": "^1.33.0",
    "micromatch": "4.0.8",
    "picocolors": "^1.1.1",
    "sasso": "^0.21.0",
    "typescript": "7.0.2"
  },
  "scripts": {
