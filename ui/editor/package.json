{
  "name": "editor",
  "private": true,
  "type": "module",
  "dependencies": {
    "@badrap/result": "^0.3.1",
    "lib": "workspace:*",
    "onnxruntime-web": "1.23.2"
  },
  "build": {
    "bundle": "src/editor*.ts",
    "sync": {
      "node_modules/onnxruntime-web/dist/ort.{wasm,webgpu}.min.mjs": "/public/npm/onnxruntime-web",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.{mjs,wasm}": "/public/npm/onnxruntime-web",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.asyncify.{mjs,wasm}": "/public/npm/onnxruntime-web"
    },
    "hash": [
      "/public/npm/onnxruntime-web/*"
    ]
  },
  "exports": {
    ".": "./dist/editor.d.ts",
    "./chess960": {
      "types": "./dist/chess960.d.ts",
      "source": "./src/chess960.ts",
      "default": "./dist/chess960.js"
    }
  }
}
